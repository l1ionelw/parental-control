{
  "manifest_version": 3,
  "key": "",
  "name": "Parental Controls - Browser Monitor",
  "version": "0.2.0",
  "description": "Reports active tab usage to the Parental Controls server via a native host that reads the trayapp config.",
  "permissions": ["tabs", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Parental Controls Browser Monitor"
  }
}
