{
  "manifest_version": 3,
  "key": "",
  "name": "Parental Controls - Browser Monitor",
  "version": "0.2.0",
  "description": "Reports active tab usage to the Parental Controls tray app running locally on this machine.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Parental Controls Browser Monitor"
  }
}
